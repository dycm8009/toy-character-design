{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toy character isolated image execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "tasks"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "identity",
            "group",
            "position_map",
            "user_reference",
            "validation"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_task": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "approved": {
          "type": "boolean"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "user_supplied"
          ]
        }
      },
      "dependentRequired": {
        "source_task": [
          "source_revision"
        ],
        "source_revision": [
          "source_task"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "identity"
              }
            }
          },
          "then": {
            "required": [
              "approved",
              "approval_ref"
            ],
            "properties": {
              "approved": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "subject",
        "prompt",
        "requirements",
        "references",
        "dependencies",
        "identity_locked",
        "requires_user_approval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "route",
            "anchor",
            "group",
            "individual",
            "validation"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "identity_locked": {
          "type": "boolean"
        },
        "requires_user_approval": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "route"
              }
            }
          },
          "then": {
            "properties": {
              "dependencies": {
                "maxProperties": 0
              },
              "requires_user_approval": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
